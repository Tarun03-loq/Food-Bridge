rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User accounts collection
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Donations collection
    match /donations/{donationId} {
      allow read: if true;
      // Only authenticated suppliers can post donations
      allow create: if request.auth != null;
      // Supplier owner or claiming NGO or Admin can update status
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Collection requests collection
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
  }
}

